# ==================================================
# JobFlow Environment Configuration
# ==================================================

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change_me_to_a_random_secure_hex_key_e.g._openssl_rand_hex_32

# Database Configuration (MySQL)
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jobflow_db

# Alternatively, set full DATABASE_URL directly:
# DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/jobflow_db?charset=utf8mb4
# For lightweight standalone/offline development without MySQL, you can use SQLite:
# DATABASE_URL=sqlite:///jobflow_dev.db
